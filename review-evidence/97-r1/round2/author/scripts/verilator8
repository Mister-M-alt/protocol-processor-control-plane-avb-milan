#!/usr/bin/env python3
"""External author-only Verilator cap; repository recipes stay otherwise intact."""
import json
import os
from pathlib import Path
import sys
original = sys.argv[1:]
args = []
i = 0
while i < len(original):
    a = original[i]
    if a in ("-j", "--build-jobs", "--verilate-jobs"):
        i += 2
        continue
    if a.startswith(("--build-jobs=", "--verilate-jobs=")) or (a.startswith("-j") and a[2:].isdigit()):
        i += 1
        continue
    args.append(a)
    i += 1
if "--getenv" not in args and "--version" not in args:
    args += ["-j", "8", "--build-jobs", "8", "--verilate-jobs", "8"]
with (Path(__file__).resolve().parent.parent / "receipts/verilator-invocations.jsonl").open("a") as f:
    f.write(json.dumps(dict(cwd=os.getcwd(), original=original, effective=args))+"\n")
os.execvp("rtk", ["rtk", "proxy", "/usr/bin/verilator", *args])
