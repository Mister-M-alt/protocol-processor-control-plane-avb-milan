#!/usr/bin/env python3
"""Run the real C++ compiler unchanged and record argv, environment, output and rc.

Used only as the fixture gate's --cxx (make CXX=...). Records go to
R230_CXX_DIR as NN.json (argv, rc, complete environment) and NN.out (the
compiler's merged stdout/stderr bytes). The same bytes are then written to
stdout and the compiler's exit status is returned, so the gate sees exactly
what the compiler printed.
"""
import json
import os
import subprocess
import sys

REAL = "/usr/bin/g++"
d = os.environ["R230_CXX_DIR"]
n = len([x for x in os.listdir(d) if x.endswith(".json")])
p = subprocess.run([REAL, *sys.argv[1:]], stdout=subprocess.PIPE,
                   stderr=subprocess.STDOUT, check=False)
with open(os.path.join(d, f"{n:02d}.out"), "wb") as f:
    f.write(p.stdout)
with open(os.path.join(d, f"{n:02d}.json"), "w", encoding="utf-8") as f:
    json.dump({"argv": sys.argv[1:], "rc": p.returncode, "env": dict(os.environ)},
              f, indent=1, sort_keys=True)
sys.stdout.buffer.write(p.stdout)
sys.stdout.flush()
sys.exit(p.returncode)
